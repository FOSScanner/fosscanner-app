# Copy this file to android/key.properties (gitignored, never commit the real one)
# and fill in the values for your local release-signing keystore.
#
# storePassword/keyPassword are the same value here: PKCS12 keystores
# (keytool's default since JDK 8u) don't support separate store/key
# passwords. keyAlias is hardcoded as "upload" to match release.yml.
storePassword=REPLACE_ME
keyPassword=REPLACE_ME
keyAlias=upload
storeFile=upload-keystore.jks
